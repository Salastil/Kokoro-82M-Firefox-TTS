{
  "name": "kokoro-82m-firefox-tts",
  "version": "0.2.0",
  "description": "Cross-browser (Firefox + Chromium) extension that reads articles or selected text aloud using Kokoro-82M TTS, synthesized by a companion server on your own machine (see server/).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "lint:ext": "web-ext lint --source-dir=extension",
    "run:ext": "web-ext run --source-dir=extension",
    "sign:ext": "web-ext sign --source-dir=extension --channel=unlisted --artifacts-dir=web-ext-artifacts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salastil/kokoro-82m-firefox-tts.git"
  },
  "keywords": [
    "firefox",
    "chrome",
    "brave",
    "webextension",
    "tts",
    "kokoro",
    "onnx",
    "text-to-speech"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/salastil/kokoro-82m-firefox-tts/issues"
  },
  "homepage": "https://github.com/salastil/kokoro-82m-firefox-tts#readme",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "web-ext": "^8.3.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "webextension-polyfill": "^0.12.0"
  }
}
